# Copy to .env. Never commit the resulting file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# SQLite is the zero-configuration local default.
# DB_ENGINE=mysql
# MYSQL_DATABASE=jobhunt
# MYSQL_USER=jobhunt
# MYSQL_PASSWORD=replace-me
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Stripe test keys for local development only.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PREMIUM_PRICE_CENTS=1999
PREMIUM_CURRENCY=usd

# Optional approved provider credentials.
JOOBLE_API_KEY=
FREELANCER_OAUTH_TOKEN=
